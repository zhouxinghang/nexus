# Copy this file to .env at the repository root and chmod 600 .env.
# Fill in all three required settings before starting Nexus.
# Values exported in the startup shell take priority over this file.
NEXUS_DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/nexus'

# Generate a bcrypt hash interactively: htpasswd -nB -C 10 owner
# Copy only the hash after "owner:". Keep single quotes around the $ signs.
NEXUS_PASSWORD_HASH=''

# Generate once with: openssl rand -hex 32
# Keep this stable across restarts; changing it invalidates existing sessions.
NEXUS_JWT_SECRET=''

NEXUS_ADDR=':8080'
# Only use false for local plain HTTP. Use true when serving HTTPS.
NEXUS_COOKIE_SECURE=false
